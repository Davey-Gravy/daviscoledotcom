{{- /*
  Custom RSS: identical to Hugo's built-in, except it EXCLUDES the gated
  `private` section by name. Version-proof safety net — filters on .Section,
  so gated posts (and their full content) never reach any public feed even if
  the build/list cascade is ignored by an older Hugo. See content/private/_index.md.
*/ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = site -}}{{- end -}}
{{- $pages := $pctx.Pages -}}
{{- if or .IsHome .IsSection -}}{{ $pages = $pctx.RegularPages -}}{{- end -}}
{{- $pages = where $pages "Section" "ne" "private" -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{ $pages = $pages | first $limit }}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ site.Title }}</description>
    <generator>Hugo</generator>{{ with site.LanguageCode }}
    <language>{{ . }}</language>{{ end }}{{ range first 1 $pages }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}{{ with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />{{ end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
