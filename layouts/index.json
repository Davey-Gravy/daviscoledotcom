{{- $sections := slice "opinions" "books" "projects" -}}
{{- $index := slice -}}
{{- range where site.RegularPages "Section" "in" $sections -}}
  {{- $index = $index | append (dict
      "title" .Title
      "url" .RelPermalink
      "section" .Section
      "summary" (.Summary | plainify | chomp)
      "content" (.Plain | chomp)
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
